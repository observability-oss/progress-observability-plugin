<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CustomAgent</RootNamespace>
    <UserSecretsId>Progress.AgentBuilder.Mvp</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.15.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.1" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.1" />
    <PackageReference Include="Progress.Observability.Instrumentation" Version="1.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Preserve source-relative paths; RecursiveDir may already include the folder. -->
    <None Update="docs/**/*.md;docs/**/*.txt"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="%(Identity)" />
    <None Update="data/**/*.csv"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="%(Identity)" />
    <Content Update="data/**/*.json;wwwroot/**/*"
             CopyToOutputDirectory="PreserveNewest"
             TargetPath="%(Identity)" />
  </ItemGroup>

</Project>
